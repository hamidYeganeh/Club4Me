{
  "name": "application",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 7081",
    "build": "next build --webpack",
    "build:cap": "node scripts/build-native.mjs",
    "start": "next start --port 7081",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint": "eslint",
    "check-types": "node ../../node_modules/typescript/bin/tsc --noEmit",
    "assets:brand": "node scripts/generate-brand-assets.mjs",
    "cap:sync": "npm run build:cap && cap sync",
    "cap:sync:hosted": "CAPACITOR_SERVER_URL=https://app.gym4me.ir cap sync android",
    "cap:sync:demo": "CAPACITOR_ALLOW_CLEARTEXT=1 CAPACITOR_DEMO=1 npm run cap:sync",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "cap:run:android": "cap run android",
    "cap:run:ios": "cap run ios",
    "cap:apk": "CAPACITOR_DEMO=1 npm run android:demo",
    "android:apk": "node scripts/verify-native.mjs && cd android && ./gradlew :app:assembleDebug",
    "android:aab": "npm run cap:sync:android && cd android && ./gradlew :app:bundleRelease",
    "native:dev": "vite --config vite.config.ts",
    "native:preview": "vite preview --config vite.config.ts",
    "ota:keygen": "node scripts/ota-keygen.mjs",
    "ota:package": "node scripts/package-update.mjs",
    "test:offline": "node --import tsx --test tests/offline/*.test.ts",
    "cap:sync:android": "npm run build:cap && cap sync android && node scripts/verify-native.mjs",
    "android:demo": "npm run cap:sync:android && npm run android:apk",
    "test:native": "playwright test --config playwright.native.config.ts",
    "e2e:fullstack": "playwright test --config playwright.fullstack.config.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capawesome/capacitor-live-update": "8.4.2",
    "@gsap/react": "^2.1.2",
    "@heroui/react": "^3.0.0",
    "@heroui/styles": "^3.0.0",
    "@hookform/resolvers": "^5.9.1",
    "@neshan-maps-platform/maplibre-sdk": "^5.24.4",
    "@number-flow/react": "^0.6.2",
    "@repo/api": "*",
    "@repo/i18n": "*",
    "@repo/theme": "*",
    "@repo/ui": "*",
    "@sentry/browser": "^10.73.0",
    "@ssgoi/react": "^7.0.4",
    "@types/qrcode": "^1.5.6",
    "@visx/event": "^4.0.1-alpha.0",
    "@visx/gradient": "^4.0.1-alpha.0",
    "@visx/grid": "^4.0.1-alpha.0",
    "@visx/group": "^4.0.1-alpha.0",
    "@visx/heatmap": "^4.0.1-alpha.0",
    "@visx/pattern": "^4.0.1-alpha.0",
    "@visx/responsive": "^4.0.1-alpha.0",
    "@visx/scale": "^4.0.1-alpha.0",
    "@visx/shape": "^4.0.1-alpha.0",
    "clsx": "^2.1.1",
    "d3-array": "^3.2.1",
    "gsap": "^3.15.0",
    "lucide-react": "^0.544.0",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "next-intl": "^4.3.4",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "react-icons": "^5.7.0",
    "swiper": "^14.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vite": "^8.2.2"
  }
}

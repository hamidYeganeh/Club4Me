{
  "name": "application",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 7081",
    "build": "next build --webpack",
    "build:cap": "CAPACITOR=1 next build --webpack",
    "start": "next start --port 7081",
    "lint": "eslint",
    "check-types": "tsc --noEmit",
    "cap:sync": "npm run build:cap && cap sync",
    "cap:sync:demo": "CAPACITOR_ALLOW_CLEARTEXT=1 CAPACITOR_DEMO=1 npm run cap:sync",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "cap:run:android": "cap run android",
    "cap:run:ios": "cap run ios",
    "cap:apk": "npm run cap:sync:demo && npm run android:apk",
    "android:apk": "cd android && ./gradlew :app:assembleDebug",
    "android:aab": "npm run cap:sync && cd android && ./gradlew :app:bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@gsap/react": "^2.1.2",
    "@heroui/react": "^3.0.0",
    "@heroui/styles": "^3.0.0",
    "@hookform/resolvers": "^5.9.1",
    "@neshan-maps-platform/maplibre-sdk": "^5.24.4",
    "@number-flow/react": "^0.6.2",
    "@repo/api": "*",
    "@repo/i18n": "*",
    "@repo/theme": "*",
    "@repo/ui": "*",
    "@ssgoi/react": "^7.0.4",
    "gsap": "^3.15.0",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "next-intl": "^4.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "swiper": "^14.2.0",
    "tailwind-variants": "^3.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

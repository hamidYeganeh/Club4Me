# Server
PORT=7088
NODE_ENV=development

# MongoDB
MONGODB_URL=mongodb://localhost:27017/club4me

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Kavenegar SMS (optional in development; required in production)
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=verify
KAVENEGAR_RESET_TEMPLATE=verify

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:7080,http://localhost:7081,http://localhost:7082,http://localhost:7083

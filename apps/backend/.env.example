# Server
PORT=7088
NODE_ENV=development
TRUST_PROXY=false

# MongoDB
MONGODB_URL=mongodb://localhost:27017/gym4me

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
MOCK_PAYMENT_CALLBACK_SECRET=replace-with-a-long-random-secret

# Large exports (local | gcs). Use gcs in production.
EXPORT_STORAGE_DRIVER=local
EXPORT_LOCAL_DIR=.artifacts/exports
EXPORT_GCS_BUCKET=
EXPORT_SIGNED_URL_MINUTES=15

# Support first-response SLA
SUPPORT_SLA_NORMAL_MINUTES=480
SUPPORT_SLA_HIGH_MINUTES=120
SUPPORT_SLA_URGENT_MINUTES=30

# Observability (optional locally, recommended in production)
APP_RELEASE=development
SENTRY_DSN=

# Firebase Admin / FCM push notifications
# Create a service account in Firebase Console > Project settings > Service accounts.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternative to the three inline values above. Keep this file outside git.
FIREBASE_SERVICE_ACCOUNT_PATH=.secrets/firebase-service-account.json

# Kavenegar SMS (optional in development; required in production)
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_OTP_TEMPLATE=gym4meotp
KAVENEGAR_RESET_TEMPLATE=gym4meotp
KAVENEGAR_BOOKING_CONFIRMED_TEMPLATE=gym4mebookingconfirmed
KAVENEGAR_BOOKING_REMINDER_TEMPLATE=gym4mebookingreminder
KAVENEGAR_BOOKING_CANCELLED_TEMPLATE=gym4mebookingcancelled
KAVENEGAR_BOOKING_RESCHEDULED_TEMPLATE=gym4mebookingrescheduled
KAVENEGAR_PAYMENT_FAILED_TEMPLATE=gym4mepaymentfailed
KAVENEGAR_PAYOUT_TEMPLATE=
KAVENEGAR_SUPPORT_TEMPLATE=
KAVENEGAR_WAITLIST_TEMPLATE=gym4mewaitlist
KAVENEGAR_OWNER_APPROVED_TEMPLATE=

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:7080,http://localhost:7081,http://localhost:7082,http://localhost:7083

# Server
PORT=7088
NODE_ENV=development
TRUST_PROXY=false
PAYMENT_HOLD_MINUTES=15
# Simulation only: no bank charges. Explicit opt-in also works with production builds.
PAYMENT_MODE=simulation
PAYMENT_SWEEP_SECONDS=30

# MongoDB: replica set required for atomic reservations and payments.
MONGODB_URL=mongodb://localhost:27017/gym4me?replicaSet=rs0

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
MOCK_PAYMENT_CALLBACK_SECRET=replace-with-a-long-random-secret

# Large exports (local | gcs). Production validation requires gcs.
EXPORT_STORAGE_DRIVER=local
EXPORT_LOCAL_DIR=.artifacts/exports
EXPORT_GCS_BUCKET=
EXPORT_SIGNED_URL_MINUTES=15
EXPORT_TTL_HOURS=24

# Support first-response SLA
SUPPORT_SLA_NORMAL_MINUTES=480
SUPPORT_SLA_HIGH_MINUTES=120
SUPPORT_SLA_URGENT_MINUTES=30

# Observability (optional locally, recommended in production)
APP_RELEASE=development
SENTRY_DSN=

# Firebase Admin / FCM push notifications
# Create a service account in Firebase Console > Project settings > Service accounts.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternative to the three inline values above. Keep this file outside git.
FIREBASE_SERVICE_ACCOUNT_PATH=

# Kavenegar SMS (optional in development; required in production)
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_OTP_TEMPLATE=gym4meotp
KAVENEGAR_RESET_TEMPLATE=gym4meotp
KAVENEGAR_BOOKING_CONFIRMED_TEMPLATE=gym4mebookingconfirmed
KAVENEGAR_BOOKING_REMINDER_TEMPLATE=gym4mebookingreminder
KAVENEGAR_BOOKING_CANCELLED_TEMPLATE=gym4mebookingcancelled
KAVENEGAR_BOOKING_RESCHEDULED_TEMPLATE=gym4mebookingrescheduled
KAVENEGAR_PAYMENT_FAILED_TEMPLATE=gym4mepaymentfailed
KAVENEGAR_PAYOUT_TEMPLATE=
KAVENEGAR_SUPPORT_TEMPLATE=
KAVENEGAR_WAITLIST_TEMPLATE=gym4mewaitlist
KAVENEGAR_OWNER_APPROVED_TEMPLATE=
APIIR_KEY=
SOCIAL_CALLBACK_BASE_URL=http://localhost:7088
SOCIAL_APP_CALLBACK_URL=http://localhost:7081/auth/social/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:7080,http://localhost:7081,http://localhost:7082,http://localhost:7083,http://localhost:7091,http://127.0.0.1:7080,http://127.0.0.1:7081,http://127.0.0.1:7082,http://127.0.0.1:7083,http://127.0.0.1:7091

# Media files: use a persistent shared volume in production. Public backend origin.
MEDIA_LOCAL_DIR=.artifacts/media
MEDIA_PUBLIC_BASE_URL=http://localhost:7088

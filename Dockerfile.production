FROM node:24-bookworm-slim AS dependencies
WORKDIR /app
ENV NODE_OPTIONS="--dns-result-order=ipv4first --tls-max-v1.2"
COPY package.json package-lock.json ./
COPY apps/website/package.json apps/website/package.json
COPY apps/application/package.json apps/application/package.json
COPY apps/admin/package.json apps/admin/package.json
COPY apps/business/package.json apps/business/package.json
COPY apps/backend/package.json apps/backend/package.json
COPY packages/api/package.json packages/api/package.json
COPY packages/eslint-config/package.json packages/eslint-config/package.json
COPY packages/i18n/package.json packages/i18n/package.json
COPY packages/theme/package.json packages/theme/package.json
COPY packages/typescript-config/package.json packages/typescript-config/package.json
COPY packages/ui/package.json packages/ui/package.json
RUN --mount=type=cache,target=/root/.npm \
    npm ci --force --prefer-offline --fetch-retries=5 --fetch-retry-maxtimeout=120000
RUN --mount=type=cache,target=/root/.npm \
    npm install --global npm@11.12.1 --prefer-offline --fetch-retries=5 --fetch-retry-maxtimeout=120000

FROM dependencies AS backend-builder
WORKDIR /app
COPY . .
RUN npm run build --workspace=backend

FROM dependencies AS builder
WORKDIR /app
COPY . .
ARG NEXT_PUBLIC_API_URL=https://api.gym4me.ir/api/v1
ARG NEXT_PUBLIC_WEBSITE_URL=https://gym4me.ir
ARG NEXT_PUBLIC_APP_RELEASE=production
ARG NEXT_PUBLIC_TINYMCE_API_KEY=
ARG NEXT_PUBLIC_NESHAN_MAP_KEY=
ARG NEXT_PUBLIC_SENTRY_DSN=
ARG NEXT_PUBLIC_API_TIMEOUT_MS=15000
ARG NEXT_PUBLIC_BASE_PATH=
ARG BUILD_FILTER=
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_WEBSITE_URL=$NEXT_PUBLIC_WEBSITE_URL \
    NEXT_PUBLIC_APP_RELEASE=$NEXT_PUBLIC_APP_RELEASE \
    NEXT_PUBLIC_TINYMCE_API_KEY=$NEXT_PUBLIC_TINYMCE_API_KEY \
    NEXT_PUBLIC_NESHAN_MAP_KEY=$NEXT_PUBLIC_NESHAN_MAP_KEY \
    NEXT_PUBLIC_SENTRY_DSN=$NEXT_PUBLIC_SENTRY_DSN \
    NEXT_PUBLIC_API_TIMEOUT_MS=$NEXT_PUBLIC_API_TIMEOUT_MS \
    NEXT_PUBLIC_BASE_PATH=$NEXT_PUBLIC_BASE_PATH
RUN if [ -n "$BUILD_FILTER" ]; then \
      npx turbo run build --filter="${BUILD_FILTER}..." --concurrency=1; \
    else \
      npm run build; \
    fi

FROM node:24-bookworm-slim AS next-runtime
ENV NODE_ENV=production HOSTNAME=0.0.0.0
RUN groupadd --system --gid 1001 nodejs \
    && useradd --system --uid 1001 --gid nodejs nextjs
USER nextjs

FROM next-runtime AS website
WORKDIR /app
COPY --from=builder --chown=nextjs:nodejs /app/apps/website/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/website/.next/static ./apps/website/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/website/public ./apps/website/public
ENV PORT=7080
EXPOSE 7080
CMD ["node", "apps/website/server.js"]

FROM next-runtime AS application
WORKDIR /app
COPY --from=builder --chown=nextjs:nodejs /app/apps/application/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/application/.next/static ./apps/application/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/application/public ./apps/application/public
ENV PORT=7081
EXPOSE 7081
CMD ["node", "apps/application/server.js"]

FROM next-runtime AS admin
WORKDIR /app
COPY --from=builder --chown=nextjs:nodejs /app/apps/admin/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/admin/.next/static ./apps/admin/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/admin/public ./apps/admin/public
ENV PORT=7082
EXPOSE 7082
CMD ["node", "apps/admin/server.js"]

FROM next-runtime AS business
WORKDIR /app
COPY --from=builder --chown=nextjs:nodejs /app/apps/business/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/business/.next/static ./apps/business/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/business/public ./apps/business/public
ENV PORT=7083
EXPOSE 7083
CMD ["node", "apps/business/server.js"]

FROM node:24-bookworm-slim AS backend-dependencies
WORKDIR /app
ENV NODE_OPTIONS="--dns-result-order=ipv4first --tls-max-v1.2"
COPY apps/backend/package.json ./package.json
RUN --mount=type=cache,target=/root/.npm \
    npm pkg delete devDependencies \
    && npm install --omit=dev --ignore-scripts --package-lock=false --prefer-offline --fetch-retries=5 --fetch-retry-maxtimeout=120000

FROM node:24-bookworm-slim AS backend
ENV NODE_ENV=production
WORKDIR /app
RUN groupadd --system --gid 1001 nodejs \
    && useradd --system --uid 1001 --gid nodejs backend \
    && mkdir -p /data/media \
    && chown backend:nodejs /data/media
COPY --from=backend-dependencies --chown=backend:nodejs /app/node_modules ./node_modules
COPY --from=backend-builder --chown=backend:nodejs /app/apps/backend/dist ./dist
USER backend
EXPOSE 7088
CMD ["node", "dist/main.js"]

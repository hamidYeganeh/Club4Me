{
  "name": "Gym4Me",
  "private": true,
  "scripts": {
    "design:sync": "node scripts/sync-sandow-design.mjs",
    "design:check": "node scripts/sync-sandow-design.mjs --check",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.12.1"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
